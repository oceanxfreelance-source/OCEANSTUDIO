{
  "name": "oceanx-studio",
  "version": "1.0.0",
  "private": true,
  "description": "OCEANX STUDIO — professional RAW/photo/video enhancement and private 48-hour client delivery platform",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx --env-file-if-exists=.env workers/index.ts",
    "worker:build": "tsc -p tsconfig.worker.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "admin:create": "tsx --env-file-if-exists=.env scripts/create-admin.ts",
    "storage:cors": "tsx --env-file-if-exists=.env scripts/configure-bucket-cors.ts",
    "cleanup:run": "tsx --env-file-if-exists=.env scripts/run-cleanup.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:all": "vitest run && playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@aws-sdk/lib-storage": "^3.1141.0",
    "@aws-sdk/s3-request-presigner": "^3.1141.0",
    "@prisma/client": "^6.19.3",
    "archiver": "^8.0.0",
    "bullmq": "^6.3.9",
    "ioredis": "^6.0.0",
    "next": "^15.5.26",
    "pino": "^10.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/archiver": "^8.0.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
