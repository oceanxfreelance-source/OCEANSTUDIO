# OCEANX STUDIO background worker: LibRaw, ExifTool, FFmpeg (+ vid.stab), sharp/libvips.
# Deploy anywhere that runs containers (Fly.io, Railway, Render, ECS, Kubernetes, a VM).
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends libraw-bin libimage-exiftool-perl ffmpeg ca-certificates tini openssl \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --include=dev && npx prisma generate
COPY lib ./lib
COPY server ./server
COPY services ./services
COPY workers ./workers
COPY scripts ./scripts
COPY tsconfig.json tsconfig.worker.json ./

ENV NODE_ENV=production \
    OCEANX_SERVICE=worker \
    WORKER_TMP_DIR=/work
RUN mkdir -p /work && chown node:node /work
USER node
# Scratch space for RAW decodes and 8× upscales can be large: mount a volume at /work.
VOLUME ["/work"]
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["npx", "tsx", "workers/index.ts"]
