# ---------------------------------------------------------------------------
# OCEANX STUDIO — environment. Copy to .env (never commit real secrets).
# ---------------------------------------------------------------------------

# Public URL of the web app (used for gallery links, CSRF origin checks and
# secure cookies — https:// enables __Host- cookies).
APP_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=postgresql://oceanx:oceanx@localhost:5432/oceanx

# ≥ 32 random characters: `openssl rand -base64 48`
AUTH_SECRET=
# Optional separate key for encrypting delivery link/password (AES-256-GCM).
DELIVERY_ENCRYPTION_KEY=
# Bearer secret for the Vercel Cron cleanup endpoint (/api/cron/cleanup)
CRON_SECRET=

# Private S3-compatible storage (Cloudflare R2, AWS S3, Backblaze B2 …)
# R2:  STORAGE_ENDPOINT=https://<account>.r2.cloudflarestorage.com  STORAGE_REGION=auto
# B2:  STORAGE_ENDPOINT=https://s3.<region>.backblazeb2.com
# S3:  leave STORAGE_ENDPOINT empty and set STORAGE_REGION
STORAGE_ENDPOINT=
# Endpoint used to sign browser-facing URLs if it differs (e.g. docker networking)
STORAGE_PUBLIC_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=false

# Optional Redis-compatible queue (BullMQ). QUEUE_URL is accepted as an alias.
# Leave empty to use Postgres as the job queue (the worker polls the database).
REDIS_URL=redis://localhost:6379
QUEUE_URL=

# AI providers. "classical" runs deterministic non-AI processing in the worker;
# "replicate" enables AI restoration / super resolution (NAFNet, Real-ESRGAN).
AI_IMAGE_PROVIDER=classical
AI_IMAGE_API_KEY=
AI_VIDEO_PROVIDER=ffmpeg
AI_VIDEO_API_KEY=
# Models: "owner/name" (official) or "owner/name:version"
REPLICATE_MODEL_UPSCALE=nightmareai/real-esrgan
REPLICATE_MODEL_RESTORE=megvii-research/nafnet
REPLICATE_MODEL_VIDEO_UPSCALE=lucataco/real-esrgan-video
REPLICATE_MAX_TILE_PIXELS=1440000

# Email (optional; delivery links are copied manually by default)
EMAIL_PROVIDER_KEY=
EMAIL_FROM=

# Limits & timings
MAX_UPLOAD_BYTES=53687091200
UPLOAD_PART_SIZE=67108864
DELIVERY_TTL_HOURS=48
DOWNLOAD_URL_TTL_SECONDS=600
PREVIEW_URL_TTL_SECONDS=900
ZIP_PART_MAX_BYTES=4294967296

# Worker
WORKER_TMP_DIR=
WORKER_CONCURRENCY_PHOTO=2
WORKER_CONCURRENCY_VIDEO=1
LOG_LEVEL=info
TRUST_PROXY=true

# Bootstrap admin (used once by `npm run admin:create`; remove afterwards)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
