# ── OCEAN X — environment variables ─────────────────────────────────────
# Copy to .env for local development. On Vercel, set these in
# Project → Settings → Environment Variables. Never commit real values.

# PostgreSQL connection string (e.g. from Neon: Dashboard → Connect).
DATABASE_URL="postgresql://user:password@localhost:5432/oceanx"

# Public address of the website (used for SEO links and the sitemap).
# On Vercel this is optional — the production domain is detected automatically.
SITE_URL="http://localhost:3000"
