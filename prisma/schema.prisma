// OCEANX STUDIO — PostgreSQL schema
//
// Core invariants enforced by application code (see lib/storage/keys.ts and server/*):
//  * media_files rows describe immutable MASTER uploads. They are never overwritten.
//  * every processing operation creates a NEW media_versions row + object.
//  * client deliveries copy published versions into /deliveries/{id}/... which is
//    the ONLY prefix that the expiration cleanup is allowed to delete.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  ADMIN
}

enum SessionKind {
  ADMIN
  CLIENT
}

enum ProjectStatus {
  DRAFT
  PROCESSING
  READY
  ACTIVE
  ARCHIVED
}

enum MediaType {
  PHOTO
  RAW
  VIDEO
}

enum MediaStatus {
  UPLOADING
  UPLOADED
  INGESTING
  READY
  FAILED
}

enum IntegrityStatus {
  UNVERIFIED
  OK
  MISMATCH
}

enum VersionType {
  ORIGINAL
  RAW_DEVELOPED
  AI_ENHANCED
  ENHANCED
  UPSCALED
  COLOR_GRADED
  VIDEO_ENHANCED
}

enum JobType {
  INGEST
  RAW_DEVELOP
  PHOTO_ENHANCE
  COLOR_GRADE
  VIDEO_ENHANCE
  VERIFY_MASTER
  DELIVERY_PREPARE
  ZIP_PACKAGE
}

enum JobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum DeliveryStatus {
  PREPARING
  ACTIVE
  EXPIRED
  DELETING
  DELETED
  REVOKED
  FAILED
}

enum StorageCategory {
  MASTER
  DERIVATIVE
  PREVIEW
  DELIVERY_FILE
  DELIVERY_PREVIEW
  DELIVERY_PACKAGE
  DELIVERY_MANIFEST
  PROCESSING_TEMP
}

enum DownloadType {
  FILE
  PACKAGE
  ADMIN_MASTER
  ADMIN_VERSION
}

enum ActorType {
  ADMIN
  CLIENT
  SYSTEM
}

enum PackageStatus {
  QUEUED
  BUILDING
  READY
  FAILED
  DELETED
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String
  passwordHash String    @map("password_hash")
  role         AdminRole @default(ADMIN)
  createdAt    DateTime  @default(now()) @map("created_at")
  lastLoginAt  DateTime? @map("last_login_at")
  disabledAt   DateTime? @map("disabled_at")

  sessions   Session[]
  deliveries Delivery[]
  jobs       ProcessingJob[]

  @@map("admin_users")
}

model Session {
  id          String      @id @default(cuid())
  tokenHash   String      @unique @map("token_hash")
  kind        SessionKind
  adminUserId String?     @map("admin_user_id")
  deliveryId  String?     @map("delivery_id")
  createdAt   DateTime    @default(now()) @map("created_at")
  expiresAt   DateTime    @map("expires_at")
  revokedAt   DateTime?   @map("revoked_at")
  lastSeenAt  DateTime?   @map("last_seen_at")
  ipHash      String?     @map("ip_hash")
  userAgent   String?     @map("user_agent")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  delivery  Delivery?  @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId])
  @@index([adminUserId])
  @@map("sessions")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  projects   Project[]
  access     ProjectAccess[]
  deliveries Delivery[]

  @@map("clients")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  shootDate   DateTime?     @map("shoot_date")
  status      ProjectStatus @default(DRAFT)
  clientId    String?       @map("client_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  archivedAt  DateTime?     @map("archived_at")

  client     Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  access     ProjectAccess[]
  media      MediaFile[]
  versions   MediaVersion[]
  jobs       ProcessingJob[]
  deliveries Delivery[]

  @@index([status])
  @@map("projects")
}

model ProjectAccess {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  clientId  String   @map("client_id")
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  client  Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([projectId, clientId])
  @@map("project_access")
}

/// Immutable master upload. Never overwritten, never replaced by AI output.
model MediaFile {
  id               String          @id @default(cuid())
  projectId        String          @map("project_id")
  filename         String
  extension        String
  mediaType        MediaType       @map("media_type")
  mimeType         String          @map("mime_type")
  size             BigInt
  width            Int?
  height           Int?
  duration         Float?
  fps              Float?
  codec            String?
  bitrate          BigInt?
  audioCodec       String?         @map("audio_codec")
  container        String?
  colorInfo        Json?           @map("color_info")
  checksum         String?
  clientChecksum   String?         @map("client_checksum")
  etag             String?
  storageKey       String          @unique @map("storage_key")
  stagingKey       String?         @map("staging_key")
  previewKey       String?         @map("preview_key")
  thumbKey         String?         @map("thumb_key")
  detailKey        String?         @map("detail_key")
  uploadId         String?         @map("upload_id")
  status           MediaStatus     @default(UPLOADING)
  isMaster         Boolean         @default(true) @map("is_master")
  integrityStatus  IntegrityStatus @default(UNVERIFIED) @map("integrity_status")
  integrityCheckedAt DateTime?     @map("integrity_checked_at")
  errorMessage     String?         @map("error_message")
  capturedAt       DateTime?       @map("captured_at")
  createdAt        DateTime        @default(now()) @map("created_at")
  uploadedAt       DateTime?       @map("uploaded_at")

  project   Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  metadata  MediaMetadata?
  versions  MediaVersion[]
  jobs      ProcessingJob[]
  favorites Favorite[]

  @@index([projectId])
  @@index([status])
  @@map("media_files")
}

model MediaMetadata {
  id           String   @id @default(cuid())
  mediaId      String   @unique @map("media_id")
  cameraMake   String?  @map("camera_make")
  cameraModel  String?  @map("camera_model")
  lens         String?
  iso          Int?
  shutter      String?
  aperture     Float?
  focalLength  Float?   @map("focal_length")
  faceRegions  Json?    @map("face_regions")
  exif         Json?
  raw          Json?
  probe        Json?
  createdAt    DateTime @default(now()) @map("created_at")

  media MediaFile @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@map("media_metadata")
}

/// Every processed asset is an independently stored version. The ORIGINAL version
/// references the master object (isMasterRef = true) and is never re-encoded.
model MediaVersion {
  id              String      @id @default(cuid())
  mediaId         String      @map("media_id")
  projectId       String      @map("project_id")
  versionNumber   Int         @map("version_number")
  versionType     VersionType @map("version_type")
  label           String
  engine          String?
  isAi            Boolean     @default(false) @map("is_ai")
  scale           Int?
  parentVersionId String?     @map("parent_version_id")
  processingJobId String?     @unique @map("processing_job_id")
  storageKey      String      @map("storage_key")
  previewKey      String?     @map("preview_key")
  thumbKey        String?     @map("thumb_key")
  detailKey       String?     @map("detail_key")
  filename        String
  mimeType        String      @map("mime_type")
  size            BigInt
  width           Int?
  height          Int?
  duration        Float?
  bitrate         BigInt?
  fps             Float?
  checksum        String?
  settings        Json?
  fidelity        Json?
  isMasterRef     Boolean     @default(false) @map("is_master_ref")
  published       Boolean     @default(false)
  publishedAt     DateTime?   @map("published_at")
  createdAt       DateTime    @default(now()) @map("created_at")

  media         MediaFile      @relation(fields: [mediaId], references: [id], onDelete: Restrict)
  project       Project        @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parent        MediaVersion?  @relation("VersionLineage", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children      MediaVersion[] @relation("VersionLineage")
  deliveryFiles DeliveryFile[]

  @@unique([mediaId, versionNumber])
  @@index([projectId, published])
  @@map("media_versions")
}

model ProcessingJob {
  id               String    @id @default(cuid())
  mediaId          String?   @map("media_id")
  projectId        String?   @map("project_id")
  deliveryId       String?   @map("delivery_id")
  sourceVersionId  String?   @map("source_version_id")
  outputVersionId  String?   @map("output_version_id")
  batchId          String?   @map("batch_id")
  jobType          JobType   @map("job_type")
  settings         Json?
  status           JobStatus @default(QUEUED)
  progress         Int       @default(0)
  stage            String?
  inputStorageKey  String?   @map("input_storage_key")
  outputStorageKey String?   @map("output_storage_key")
  errorMessage     String?   @map("error_message")
  technicalLog     String?   @map("technical_log")
  attempts         Int       @default(0)
  createdById      String?   @map("created_by_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  startedAt        DateTime? @map("started_at")
  completedAt      DateTime? @map("completed_at")

  media     MediaFile? @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  delivery  Delivery?  @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([mediaId])
  @@index([batchId])
  @@map("processing_jobs")
}

model ProcessingPreset {
  id        String   @id @default(cuid())
  name      String
  kind      String
  settings  Json
  builtIn   Boolean  @default(false) @map("built_in")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, name])
  @@map("processing_presets")
}

model Delivery {
  id                 String         @id @default(cuid())
  number             Int            @default(autoincrement())
  projectId          String         @map("project_id")
  clientId           String         @map("client_id")
  title              String
  secureTokenHash    String         @unique @map("secure_token_hash")
  tokenCiphertext    String         @map("token_ciphertext")
  passwordHash       String         @map("password_hash")
  passwordCiphertext String         @map("password_ciphertext")
  status             DeliveryStatus @default(PREPARING)
  allowFavorites     Boolean        @default(true) @map("allow_favorites")
  watermarkPreviews  Boolean        @default(false) @map("watermark_previews")
  manifest           Json?
  createdAt          DateTime       @default(now()) @map("created_at")
  expiresAt          DateTime       @map("expires_at")
  expiredAt          DateTime?      @map("expired_at")
  revokedAt          DateTime?      @map("revoked_at")
  deletedAt          DateTime?      @map("deleted_at")
  cleanupAttempts    Int            @default(0) @map("cleanup_attempts")
  cleanupLockedUntil DateTime?      @map("cleanup_locked_until")
  lastCleanupError   String?        @map("last_cleanup_error")
  createdById        String?        @map("created_by")
  renewedFromId      String?        @map("renewed_from_id")

  project   Project           @relation(fields: [projectId], references: [id], onDelete: Restrict)
  client    Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdBy AdminUser?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  files     DeliveryFile[]
  packages  DeliveryPackage[]
  sessions  Session[]
  favorites Favorite[]
  downloads Download[]
  jobs      ProcessingJob[]

  @@index([status, expiresAt])
  @@map("deliveries")
}

model DeliveryFile {
  id         String    @id @default(cuid())
  deliveryId String    @map("delivery_id")
  mediaId    String    @map("media_id")
  versionId  String    @map("version_id")
  filename   String
  label      String
  mediaType  MediaType @map("media_type")
  mimeType   String    @map("mime_type")
  size       BigInt
  checksum   String?
  width      Int?
  height     Int?
  duration   Float?
  storageKey String    @map("storage_key")
  previewKey String?   @map("preview_key")
  thumbKey   String?   @map("thumb_key")
  sortOrder  Int       @default(0) @map("sort_order")
  copiedAt   DateTime? @map("copied_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  delivery  Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  version   MediaVersion @relation(fields: [versionId], references: [id], onDelete: Restrict)
  favorites Favorite[]
  downloads Download[]

  @@unique([deliveryId, versionId])
  @@index([deliveryId])
  @@map("delivery_files")
}

model DeliveryPackage {
  id         String        @id @default(cuid())
  deliveryId String        @map("delivery_id")
  partNumber Int           @map("part_number")
  totalParts Int           @map("total_parts")
  filename   String
  storageKey String        @map("storage_key")
  size       BigInt        @default(0)
  fileCount  Int           @default(0) @map("file_count")
  status     PackageStatus @default(QUEUED)
  createdAt  DateTime      @default(now()) @map("created_at")

  delivery  Delivery   @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  downloads Download[]

  @@unique([deliveryId, partNumber])
  @@map("delivery_packages")
}

/// Registry of every object written by the application. Temporary objects are
/// tied to a delivery and are the only ones the cleanup worker deletes.
model StorageObject {
  id         String          @id @default(cuid())
  key        String          @unique
  category   StorageCategory
  size       BigInt          @default(0)
  temporary  Boolean         @default(false)
  projectId  String?         @map("project_id")
  mediaId    String?         @map("media_id")
  versionId  String?         @map("version_id")
  deliveryId String?         @map("delivery_id")
  createdAt  DateTime        @default(now()) @map("created_at")
  deletedAt  DateTime?       @map("deleted_at")

  @@index([category, deletedAt])
  @@index([deliveryId])
  @@map("storage_objects")
}

model Download {
  id             String       @id @default(cuid())
  deliveryId     String?      @map("delivery_id")
  deliveryFileId String?      @map("delivery_file_id")
  packageId      String?      @map("package_id")
  mediaId        String?      @map("media_id")
  versionId      String?      @map("version_id")
  downloadType   DownloadType @map("download_type")
  label          String?
  ipHash         String?      @map("ip_hash")
  userAgent      String?      @map("user_agent")
  createdAt      DateTime     @default(now()) @map("created_at")

  delivery     Delivery?        @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  deliveryFile DeliveryFile?    @relation(fields: [deliveryFileId], references: [id], onDelete: SetNull)
  package      DeliveryPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@index([deliveryId])
  @@index([mediaId])
  @@index([createdAt])
  @@map("downloads")
}

model Favorite {
  id             String   @id @default(cuid())
  deliveryId     String   @map("delivery_id")
  deliveryFileId String   @map("delivery_file_id")
  mediaId        String   @map("media_id")
  createdAt      DateTime @default(now()) @map("created_at")

  delivery     Delivery     @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  deliveryFile DeliveryFile @relation(fields: [deliveryFileId], references: [id], onDelete: Cascade)
  media        MediaFile    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, deliveryFileId])
  @@map("favorites")
}

model Watermark {
  id        String   @id @default(cuid())
  text      String
  opacity   Float    @default(0.35)
  position  String   @default("center")
  scale     Float    @default(0.05)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("watermarks")
}

model AuditLog {
  id         String    @id @default(cuid())
  action     String
  actorType  ActorType @map("actor_type")
  actorId    String?   @map("actor_id")
  projectId  String?   @map("project_id")
  deliveryId String?   @map("delivery_id")
  mediaId    String?   @map("media_id")
  details    Json?
  ipHash     String?   @map("ip_hash")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}
